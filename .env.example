# Copy to .env for local development. Never commit the real .env file (see
# .gitignore). All of these are consumed via runtimeConfig in nuxt.config.ts.
# Every var below is server-only (CLAUDE.md: "Cero API Keys en el cliente")
# EXCEPT NUXT_PUBLIC_TURNSTILE_SITE_KEY, which is meant to ship to the
# browser — Cloudflare's site key isn't a secret, only the matching secret
# key is (that one stays server-only, see below).

# Brevo Contacts API (https://app.brevo.com/settings/keys/api) — shared by
# both server/api/contact.post.ts and server/api/subscribe.post.ts via
# server/utils/brevo.ts. Requires the NOMBRE / COMPANY / INTEREST / MESSAGE /
# SOURCE contact attributes to already exist in the Brevo dashboard
# (Contacts → Settings → Contact Attributes) before contacts start upserting.
# NOMBRE is this account's renamed built-in first-name attribute, so the
# payload sends NOMBRE rather than Brevo's stock FIRSTNAME.
NUXT_BREVO_API_KEY=

# Numeric Brevo list IDs (Contacts → Lists → the list's ID in its URL/settings).
# Kept separate so the full Contact-section form and the lighter-weight
# FloatingCtaDrawer widget can be segmented/reported on independently in Brevo.
NUXT_BREVO_CONTACT_LIST_ID=6
NUXT_BREVO_CTA_LIST_ID=5

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile).
# INTENTIONALLY BLANK: this project relies on the invisible honeypot in
# server/api/*.post.ts rather than a visible captcha. While these are empty
# the widget is never rendered (no Cloudflare script or iframe is requested,
# see the turnstileEnabled gate in both form components) and server-side
# verification is skipped (server/utils/turnstile.ts). Setting both is all it
# takes to turn the captcha on later.
NUXT_TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
